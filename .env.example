# MemoryFlow Environment Configuration Template
# Copy this file to .env for local overrides

# Server & Dev Host binding (defaults to 127.0.0.1 loopback for local security)
HOST=127.0.0.1
PORT=5173

# Optional: Google Drive API Key for read-only public or unlisted Drive folders
# If omitted, simulated multi-camera event folder seeding or browser OAuth can be used
VITE_GOOGLE_API_KEY=

# Local Admin Default Passphrase
# Used by organizer to manage collections, configure Drive, and approve suggestions
ADMIN_PASSPHRASE=admin123

# Server Session Signing Secret (automatically generated if not provided)
SERVER_SECRET=
